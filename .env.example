# --- Server ---
PORT=8787
CLIENT_ORIGIN=http://localhost:8787
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
# 64 hex chars (32 bytes). Generate with: npm run gen-key
DATA_ENCRYPTION_KEY=change-me-generate-with-npm-run-gen-key-64hexchars000000
# Cookie: set SECURE_COOKIES=true in production (https)
SECURE_COOKIES=false

# --- AI backend (any OpenAI-compatible endpoint — no `opencode serve` needed) ---
# Option A, direct provider mode (recommended on phones):
#   OPENCODE_BASE_URL=<provider endpoint>  e.g. https://openrouter.ai/api/v1
#   OPENCODE_API_KEY=<your provider key>
#   OPENCODE_MODEL=<exact model id, e.g. anthropic/claude-sonnet-4>
# Option B, local opencode server: opencode auth login → opencode serve --port 4096
#   then keep OPENCODE_BASE_URL=http://127.0.0.1:4096/v1 and leave API key empty.
OPENCODE_BASE_URL=https://integrate.api.nvidia.com/v1
OPENCODE_MODEL=openai/gpt-oss-20b
# NVIDIA NIM key from https://build.nvidia.com (starts with nvapi-...):
OPENCODE_API_KEY=
# If opencode is offline, app uses a built-in offline comforting responder
# so auth + UI still work. Set to true to force offline mode:
OFFLINE_MODE=false

# --- Auth: email + password only (SQLite, zero setup) ---

# --- Privacy ---
# Auto-delete messages older than N days (0 = disabled)
RETENTION_DAYS=30
